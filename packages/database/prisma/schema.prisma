generator client {
 provider = "prisma-client-js"
}
datasource db {
 provider = "postgresql"
}
enum ImportStatus {
 PENDING
 PROCESSING
 FAILED
 PARSED
 REVIEW
 DISMISSED
}
enum MovementType {
 INCOME
 EXPENSE
 TRANSFER
}
enum Currency {
 DOP
 USD
}
model MailImport {
 id String @id @default(cuid())
 externalId String @unique
 body String
 status ImportStatus @default(PENDING)
 reason String?
 parserVersion String @default("demo-v1")
 attempts Int @default(0)
 manualRetries Int @default(0)
 nextAttemptAt DateTime @default(now())
 lastAttemptAt DateTime?
 lockedUntil DateTime?
 lockToken String?
 lastErrorCode String?
 processedAt DateTime?
 createdAt DateTime @default(now())
 movement Movement?
 @@index([status, createdAt])
 @@index([status, nextAttemptAt])
}
model Movement {
 id String @id @default(cuid())
 amountMinor Int
 currency Currency
 type MovementType
 description String
 category String @default("Sin categorizar")
 categoryId String?
 categoryRef Category? @relation(fields: [categoryId], references: [id], onDelete: Restrict)
 occurredAt DateTime
 createdAt DateTime @default(now())
 importId String? @unique
 recurrenceOccurrence RecurringOccurrence?
 source MailImport? @relation(fields: [importId], references: [id])
 @@index([currency, occurredAt])
 @@index([categoryId])
}

model Category {
 id String @id @default(cuid())
 name String
 normalizedName String @unique
 archived Boolean @default(false)
 system Boolean @default(false)
 movements Movement[]
 recurringTemplates RecurringTemplate[]
}

model RecurringTemplate {
 id String @id @default(cuid())
 version Int @default(0)
 description String
 amountMinor Int
 currency Currency
 type MovementType
 category String
 categoryId String
 categoryRef Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
 startDate String
 nextDate String
 anchorDay Int
 active Boolean @default(true)
 occurrences RecurringOccurrence[]
}
model RecurringOccurrence {
 id String @id @default(cuid())
 templateId String
 template RecurringTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)
 scheduledFor String
 movementId String? @unique
 movement Movement? @relation(fields: [movementId], references: [id], onDelete: SetNull)
 confirmedAt DateTime @default(now())
 @@unique([templateId,scheduledFor])
}

model AppOwner {
 id Int @id @default(1)
 name String
 email String @unique
 passwordHash String
 createdAt DateTime @default(now())
 sessions AccessSession[]
 recoveryCodes RecoveryCode[]
 cleanups DataCleanup[]
 cleanupPreview CleanupPreview?
}
model AccessSession {
 id String @id @default(cuid())
 ownerId Int
 owner AppOwner @relation(fields: [ownerId], references: [id], onDelete: Cascade)
 tokenHash String @unique
 createdAt DateTime @default(now())
 expiresAt DateTime
 revokedAt DateTime?
 @@index([ownerId, expiresAt])
}
model AuthThrottle {
 key String @id
 startedAt DateTime
 attempts Int
}

model RecoveryCode {
 id String @id @default(cuid())
 ownerId Int
 owner AppOwner @relation(fields: [ownerId], references: [id], onDelete: Cascade)
 codeHash String @unique
 createdAt DateTime @default(now())
 expiresAt DateTime
 usedAt DateTime?
 @@index([ownerId, expiresAt])
}
model DataCleanup {
 id String @id @default(cuid())
 ownerId Int
 owner AppOwner @relation(fields: [ownerId], references: [id], onDelete: Cascade)
 cutoff DateTime
 reviewBodies Int
 failedBodies Int
 accessRecords Int
 createdAt DateTime @default(now())
}
model CleanupPreview {
 ownerId Int @id
 owner AppOwner @relation(fields: [ownerId], references: [id], onDelete: Cascade)
 id String @unique
 cutoff DateTime
 importIds String[]
 expiresAt DateTime
}
