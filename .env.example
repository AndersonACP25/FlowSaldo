DATABASE_URL=postgresql://flowsaldo:flowsaldo_local@127.0.0.1:5433/flowsaldo
DEV_API_TOKEN=replace-with-a-random-token-at-least-24-characters
PORT=3000
HOST=127.0.0.1
WEB_ORIGINS=http://localhost:8081,http://127.0.0.1:8081

# Solo detrás de un proxy TLS local confiable que sobrescriba encabezados:
# TRUST_PROXY_LOOPBACK=1

# 0 desactiva la retención. Usa 7–365 días para activarla en el worker.
# AUTO_RETENTION_DAYS=0

# HTTPS directo. Configura ambos archivos PEM; usa la cadena completa del certificado.
# TLS_CERT_FILE=/ruta/al/fullchain.pem
# TLS_KEY_FILE=/ruta/a/la/privkey.pem
