{
  "name": "flowsaldo",
  "private": true,
  "version": "0.10.0",
  "engines": {
    "node": ">=24.11 <25"
  },
  "scripts": {
    "setup:local": "pnpm install --frozen-lockfile && pnpm db:setup",
    "doctor:expo": "pnpm --filter @flowsaldo/mobile exec node -p \"require.resolve('expo/package.json')\"",
    "doctor:api": "node --env-file-if-exists=.env scripts/doctor-api.mjs",
    "dev": "node scripts/dev.mjs web",
    "dev:android": "node scripts/dev.mjs android",
    "dev:phone": "node scripts/dev.mjs go",
    "db:setup": "pnpm db:generate && pnpm exec prisma migrate deploy --config packages/database/prisma.config.ts",
    "start": "node scripts/expo.mjs go",
    "web": "node scripts/expo.mjs web",
    "android": "node scripts/expo.mjs android",
    "dev:api": "pnpm --filter @flowsaldo/api dev",
    "dev:worker": "pnpm --filter @flowsaldo/worker dev",
    "db:generate": "pnpm --filter @flowsaldo/database generate",
    "db:migrate": "pnpm --filter @flowsaldo/database migrate",
    "data:admin": "node --env-file-if-exists=.env scripts/data-admin.mjs",
    "db:seed": "pnpm --filter @flowsaldo/database seed",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint .",
    "test": "node --test packages/domain/test/core.test.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm text:check && pnpm exports:test",
    "test:web": "node scripts/test-web.mjs",
    "test:dev": "node scripts/dev-smoke.mjs",
    "ai:validate": "node scripts/ai.mjs validate",
    "ai:plan": "node scripts/ai.mjs plan",
    "ai:packet": "node scripts/ai.mjs packet",
    "ai:handoff": "node scripts/ai.mjs handoff",
    "ai:test": "node --test scripts/ai.test.mjs",
    "text:check": "node scripts/text-check.mjs",
    "exports:check": "node scripts/export-guardian.mjs",
    "exports:test": "node --test scripts/export-guardian.test.mjs",
    "format": "prettier --write",
    "format:check": "prettier --check"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.39.0",
    "exceljs": "^4.4.0",
    "playwright": "^1.64.1",
    "prettier": "3.10.1",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0"
  },
  "packageManager": "pnpm@12.18.0"
}
