{
  "name": "flowsaldo",
  "private": true,
  "version": "0.2.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24.11 <25"
  },
  "scripts": {
    "start": "npm exec -w @flowsaldo/mobile -- expo start --go",
    "web": "npm exec -w @flowsaldo/mobile -- expo start --web",
    "android": "npm exec -w @flowsaldo/mobile -- expo start --android --go",
    "dev:api": "npm run dev -w @flowsaldo/api",
    "dev:worker": "npm run dev -w @flowsaldo/worker",
    "db:generate": "npm run generate -w @flowsaldo/database",
    "db:migrate": "npm run migrate -w @flowsaldo/database",
    "db:seed": "npm run seed -w @flowsaldo/database",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "test": "node --test packages/domain/test/*.test.ts",
    "check": "npm run lint && npm run typecheck && npm test",
    "dev:mobile": "npm start",
    "test:web": "npm exec -w @flowsaldo/mobile -- expo export --platform web --output-dir ../../dist/web && node scripts/web-smoke.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.39.0",
    "playwright": "^1.64.1",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0"
  }
}
